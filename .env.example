# --- Philips Hue remote API (OAuth) ---
# From your Hue developer app: https://developers.meethue.com/my-apps/
HUE_CLIENT_ID=your-oauth-client-id
HUE_CLIENT_SECRET=your-oauth-client-secret
# Bearer token from the OAuth pairing flow (see README)
HUE_TOKEN=your-access-token
# Refresh token from the OAuth pairing flow — used to renew HUE_TOKEN automatically
HUE_REFRESH_TOKEN=your-refresh-token
# Bridge whitelist user ("application key") created during pairing
HUE_USERNAME=your-hue-username
# Remote API base (leave as-is unless you know what you're doing)
HUE_URI=https://api.meethue.com
# Default lamp to control (exact name as in the Hue app; CLI/API can override)
HUE_LAMP=Desk Lamp

# --- Location for the weather forecast ---
LATITUDE=59.33
LONGITUDE=18.07
TIMEZONE=Europe/Stockholm

# --- Color-logic thresholds (optional overrides; defaults shown) ---
# RAIN_MIN_MM=0.1       # total 12h precipitation (mm) that counts as rain
# RAIN_HEAVY_MM=5.0     # beyond this -> deeper, brighter blue
# SNOW_MIN_CM=0.1       # total 12h snowfall (cm) that counts as snow
# SNOW_HEAVY_CM=2.0     # beyond this -> brighter cold white
# TEMP_ORANGE_C=25.0    # daily max above this (and no precip) -> orange
# TEMP_RED_C=30.0       # daily max above this (and no precip) -> red
